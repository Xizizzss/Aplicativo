{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite"
    },
    "servidor": {
      "root": "Servidor",
      "framework": "express"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "servidor" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "app" }
    }
  ]
}
